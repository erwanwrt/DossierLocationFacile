# Better-Auth Configurations
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Database Configuration (for Better-Auth Pool)
# Copy the PostgreSQL connection string from Supabase (URI style)
DATABASE_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[project-id].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Drive API Configuration (Service Account)
# Get these values from your Google Cloud Console Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL="uploader-service-account@[project-id].iam.gserviceaccount.com"
# For the private key, wrap it in double quotes and replace literal newlines if needed, or we will parse it.
# It should look like: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ..."
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-parent-folder-id"

# Resend Transactional Email Configuration
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="Dossier Location Facile <candidatures@your-verified-domain.fr>"
